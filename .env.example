# =============================================
# KONFIGURASI PATH - Salin file ini menjadi .env
# lalu isi sesuai path Google Drive kamu
# =============================================

# --- Google Drive Base ---
# Contoh: /content/drive/MyDrive/NamaFolderSkripsi
DRIVE_BASE_PATH=/content/drive/MyDrive/skripsian

# --- Path Data ---
DATA_PATH=${DRIVE_BASE_PATH}/data
TKPI_EXCEL_PATH=${DATA_PATH}/tkpi-2019.xlsx
AKG_CSV_PATH=${DATA_PATH}/akg_clean.csv
PROCESSED_DATA_PATH=${DATA_PATH}/processed

# --- Path ChromaDB ---
CHROMA_PATH=${DRIVE_BASE_PATH}/chroma_db/chroma_tkpi_full

# --- Path Notebook/Modul Python ---
NOTEBOOK_BASE_PATH=${DRIVE_BASE_PATH}/Notebook

# --- (Opsional) Jika kamu pakai LoRA adapter fine-tuned ---
# LORA_ADAPTER_PATH=${DRIVE_BASE_PATH}/adapters/gizi_assistant_lora_1.5b
